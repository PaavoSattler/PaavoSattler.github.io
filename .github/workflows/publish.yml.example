# Rename this file to publish.yml only when the repository is public
# and GitHub Pages is ready to be enabled.
#
# Before enabling it:
# 1. Locally run: quarto publish gh-pages
#    This initializes the gh-pages publication target / branch.
# 2. In GitHub: Settings -> Actions -> General -> Workflow permissions
#    choose Read and write permissions.
# 3. In GitHub: Settings -> Pages -> deploy from the gh-pages branch.
#
# For this static website there are no R/Python computations that need to be
# recreated in CI.

name: Quarto Publish

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: write

jobs:
  build-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v7

      - name: Set up Quarto
        uses: quarto-dev/quarto-actions/setup@v2

      - name: Render and publish to GitHub Pages branch
        uses: quarto-dev/quarto-actions/publish@v2
        with:
          target: gh-pages
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
